---
# tasks file for loadbalancer
# 1. VPC 정보 조회
- name: VPC Info
  amazon.aws.ec2_vpc_net_info:
    filters:
      "tag:Name": "{{ prefix }}-vpc"
    region: "{{ region }}"
  register: vpc_info

- name: Set VPC ID
  set_fact:
    target_vpc_id: "{{ vpc_info.vpcs[0].id }}"
  when: vpc_info.vpcs | length > 0

# 2. 대상 그룹 생성
- name: Jenkins Target Group
  community.aws.elb_target_group: # 사전 설치된 community collection 사용
    name: "{{ alb_name.jenkins_tg }}"
    port: 80
    protocol: http
    vpc_id: "{{ target_vpc_id }}"
    region: "{{ region }}"
    target_type: ip
    targets:
      - id: "{{ jenkins_ip }}"
        port: 80
    health_check_path: "/login"
    state: present

# 3. 로드 밸런서 본체 생성 (리스너 제외)
- name: Jenkins Application Load Balancer
  amazon.aws.elb_application_lb:
    name: "{{ alb_name.jenkins_alb }}"
    subnets: 
      - "{{ subnets.pub_1a.subnet_id }}"
      - "{{ subnets.pub_2c.subnet_id }}"
    security_groups:
      - "{{ security_groups.http }}"
      - "{{ security_groups.https }}"
    region: "{{ region }}"
    state: present

# 4. 리스너 생성 및 연결 (동일 모듈로 업데이트)
- name: Jenkins ALB Listener Setup
  amazon.aws.elb_application_lb:
    name: "{{ alb_name.jenkins_alb }}"
    subnets: 
      - "{{ subnets.pub_1a.subnet_id }}"
      - "{{ subnets.pub_2c.subnet_id }}"
    security_groups:
      - "{{ security_groups.http }}"
      - "{{ security_groups.https }}"
    region: "{{ region }}"
    state: present
    # 이 단계에서 리스너 설정을 추가하여 결합합니다.
    listeners: 
      - Protocol: HTTP
        Port: 80
        DefaultActions:
          - Type: forward
            TargetGroupName: "{{ alb_name.jenkins_tg }}"
  
